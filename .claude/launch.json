{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d api && .\\mvnw.cmd -q spring-boot:run"],
      "port": 8080
    },
    {
      "name": "analysis",
      "runtimeExecutable": "analysis/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "--app-dir", "analysis", "app.main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
