# Web
NEXT_PUBLIC_API_URL=http://localhost:8080

# API
CODEMIND_ANALYSIS_URL=http://localhost:8000
CODEMIND_WORKSPACE=${USERPROFILE}/.codemind
# HMAC key for signing login tokens: at least 32 bytes. The default in application.yml is for local dev only.
CODEMIND_JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-bytes
